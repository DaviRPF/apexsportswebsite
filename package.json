    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-session": "^1.18.1",
    "pino": "^9.5.0",
    "qrcode-terminal": "^0.12.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
